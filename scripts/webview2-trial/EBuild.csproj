<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>5</LangVersion>
    <AssemblyName>EBuild-WebView2</AssemblyName>
    <ApplicationIcon>ui\icon.ico</ApplicationIcon>
    <ApplicationManifest>windows.manifest</ApplicationManifest>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="verify\**\*.cs" />
    <None Remove="ui\landscape.png" />
    <None Update="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="bridge.js;channels.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt" Condition="'$(PkgMicrosoft_Web_WebView2)' != ''"
          Link="WEBVIEW2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
