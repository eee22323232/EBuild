<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>EBuild-WPF</AssemblyName>
    <WpfReleaseVersion>0.1.3</WpfReleaseVersion>
    <Version>$(WpfReleaseVersion)</Version>
    <InformationalVersion>dev.$(WpfReleaseVersion)</InformationalVersion>
    <RootNamespace>EBuild.Native</RootNamespace>
    <ApplicationIcon>..\webview2-trial\ui\icon.ico</ApplicationIcon>
    <ApplicationManifest>windows.manifest</ApplicationManifest>
    <StartupObject>EBuild.Native.Launcher</StartupObject>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="verify\**\*.cs" />
    <Compile Include="..\webview2-trial\*.cs" Exclude="..\webview2-trial\Host.cs" />
    <Resource Include="..\webview2-trial\ui\icon.ico" Link="icon.ico" />
    <Resource Include="..\webview2-trial\ui\icons\*.svg" Link="icons\%(Filename)%(Extension)" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="RecordWorkingTreeStatus" BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain --untracked-files=normal" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_WorkingTreeChanges" />
      <Output TaskParameter="ExitCode" PropertyName="_GitStatusExitCode" />
    </Exec>
    <PropertyGroup>
      <_WorkingTreeState Condition="'$(_GitStatusExitCode)' != '0'">unknown</_WorkingTreeState>
      <_WorkingTreeState Condition="'$(_GitStatusExitCode)' == '0' and '@(_WorkingTreeChanges)' != ''">modified</_WorkingTreeState>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WorkingTreeState)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>WorkingTreeState</_Parameter1>
        <_Parameter2>$(_WorkingTreeState)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
