<Window x:Class="PrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EBuild 启动器 · WPF 测试版" Icon="icon.ico"
        Width="938" Height="575" MinWidth="750" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#EAF0F6"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Foreground="#182438" UseLayoutRounding="True" Loaded="WindowLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#315BB2"/>
        <SolidColorBrush x:Key="Muted" Color="#52637A"/>
        <SolidColorBrush x:Key="Line" Color="#D7E0EA"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#182438"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="BorderBrush" Value="#739AF0"/>
                                <Setter TargetName="Background" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Opacity" Value="0.47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Navigation" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="7" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#426BBD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#5278C3"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#7394D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>
        <Grid ClipToBounds="True">
            <Grid x:Name="HomePage" Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="实例" FontSize="23" FontWeight="Bold" Margin="0,0,0,13"/>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="11" Background="#EAF0FF"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image Source="icon.ico" Width="37" Height="37"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="当前实例" Foreground="{StaticResource Muted}" FontSize="12"/>
                            <TextBlock x:Name="InstanceTitle" Text="正在读取实例…" FontWeight="Bold"
                                       FontSize="22" TextTrimming="CharacterEllipsis" Margin="0,3,0,4"/>
                            <TextBlock x:Name="InstanceVersion" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="LaunchButton" Content="启动测试副本" Click="LaunchClicked"
                                    Style="{StaticResource Primary}" IsEnabled="False"/>
                            <Button x:Name="StopButton" Content="停止游戏" Click="StopClicked"
                                    Margin="0,7,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="已安装的实例" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <ListBox x:Name="InstanceList" Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}"
                         BorderThickness="1" SelectionChanged="InstanceChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="已安装的实例">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="13,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Details}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18">
                    <TextBlock Text="设置" FontSize="23" FontWeight="Bold" Margin="0,0,0,13"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="测试副本的游戏设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Label Grid.Row="1" Content="最大内存（MB）" Padding="0,5,0,0" Target="{Binding ElementName=MemoryBox}"/>
                            <TextBox x:Name="MemoryBox" Grid.Row="1" Grid.Column="1" Padding="8,6" MaxLength="5"/>
                            <Label Grid.Row="2" Content="启动游戏后" Padding="0,5,0,0" Margin="0,10,0,0"
                                   Target="{Binding ElementName=AfterLaunch}"/>
                            <ComboBox x:Name="AfterLaunch" Grid.Row="2" Grid.Column="1" Padding="8,5" Margin="0,10,0,0">
                                <ComboBoxItem Content="保留启动器"/>
                                <ComboBoxItem Content="最小化启动器"/>
                            </ComboBox>
                            <Button Grid.Row="3" Grid.Column="1" Content="保存设置" Margin="0,15,0,0"
                                    Style="{StaticResource Primary}" Click="SaveClicked"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#F6F8FB" Padding="22,9">
            <TextBlock x:Name="StatusText" Text="正在读取实例…" TextTrimming="CharacterEllipsis" FontSize="12"
                       Foreground="{StaticResource Muted}"/>
        </Border>
        <UniformGrid Grid.Row="2" Columns="2" Background="{StaticResource Blue}" Margin="0">
            <RadioButton x:Name="HomeTab" Margin="10,6,5,6" IsChecked="True" GroupName="Pages"
                         Style="{StaticResource Navigation}" Click="HomeClicked" Content="实例"/>
            <RadioButton Margin="5,6,10,6" GroupName="Pages" Style="{StaticResource Navigation}"
                         Click="SettingsClicked" Content="设置"/>
        </UniformGrid>
    </Grid>
</Window>
