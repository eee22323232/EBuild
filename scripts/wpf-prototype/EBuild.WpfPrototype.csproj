<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>5</LangVersion>
    <AssemblyName>EBuild-WPF-Prototype</AssemblyName>
    <ApplicationIcon>..\webview2-trial\ui\icon.ico</ApplicationIcon>
    <StartupObject>PrototypeWindow</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\webview2-trial\*.cs" Exclude="..\webview2-trial\Host.cs" />
    <Resource Include="..\webview2-trial\ui\icon.ico" Link="icon.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
