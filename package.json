{
  "name": "ebuild-launcher",
  "productName": "EBuild",
  "version": "0.1.0-dev",
  "license": "MIT",
  "private": true,
  "description": "EBuild Minecraft Java 版启动器",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . EBuild --platform=win32 --arch=x64 --asar --out=dist --overwrite --icon=src/ui/icon.ico --ignore=^/README.md$ --ignore=^/docs/ --ignore=^/node_modules/[.]cache --ignore=^/src/ui/landscape.png$ --ignore=^/游戏数据"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "undici": "7.30.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1"
  }
}
